# Settings of docker-compose.yml. Copy to .env (gitignored, never commit it) and
# adjust; every key has a working default. The commented keys at the end are
# used only by the optional agent overlay (docker-compose.override.example.yml).

# === Container ===
PROJECT_NAME=ccg-diffusion
CONTAINER_NAME=ccg-diffusion
IMAGE_NAME=ccg-diffusion:runtime
# Host UID/GID of the user that owns the checkout (`id -u`, `id -g`).
HOST_UID=1000
HOST_GID=1000
SHM_SIZE=64gb

# === GPUs ===
# Comma-separated GPU indices or UUIDs (GPU-<uuid>, from `nvidia-smi -L`) passed to the NVIDIA runtime, or "all".
NVIDIA_VISIBLE_DEVICES=all

# === Data and run outputs (mounted over dataset/ and output/ of the checkout) ===
DATASET_DIR=./dataset
OUTPUT_DIR=./output

# === API keys ===
# Hugging Face token (optional: the pinned models are public). Leave empty unless needed.
HF_TOKEN=
# OpenAI API key, needed only by the GPT-6 Astra judge of TAB PP (`python -m scripts.tab_pp.judge_astra run`).
OPENAI_API_KEY=

# === Agent overlay (optional; docker-compose.override.yml only) ===
# Uncomment and fill in what you use; a tool whose token is unset is not configured.
# Git identity of commits made inside the container.
# GIT_AUTHOR_NAME=<your-name>
# GIT_AUTHOR_EMAIL=<your-email>
# GIT_SAFE_DIRECTORY=/workspace/ccg-diffusion
# Tokens of the in-container tools.
# GITHUB_PERSONAL_ACCESS_TOKEN=<your-github-token>
# CLAUDE_CODE_OAUTH_TOKEN=<your-claude-code-oauth-token>
# CODEX_ACCESS_TOKEN=<your-codex-access-token>
# NOTION_TOKEN=<your-notion-token>
# WANDB_API_KEY=<your-wandb-api-key>
# Host paths mounted into the container (defaults: ~/.ssh, ~/.claude, ~/.claude.json, ~/.codex).
# SSH_DIR=<host-ssh-dir>
# CLAUDE_CONFIG_DIR=<host-claude-config-dir>
# CLAUDE_JSON=<host-claude-json-file>
# CODEX_CONFIG_DIR=<host-codex-config-dir>
